{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://job-tracker.local/schemas/mail_scan_events.schema.json",
  "title": "Mail scan NDJSON event",
  "oneOf": [
    { "$ref": "#/$defs/started" },
    { "$ref": "#/$defs/source_started" },
    { "$ref": "#/$defs/listing" },
    { "$ref": "#/$defs/source_finished" },
    { "$ref": "#/$defs/warning" },
    { "$ref": "#/$defs/finished" }
  ],
  "$defs": {
    "cursor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size", "mtime_ns", "offset", "last_message_id"],
      "properties": {
        "size": { "type": "integer", "minimum": 0 },
        "mtime_ns": { "type": "integer", "minimum": 0 },
        "offset": { "type": "integer", "minimum": 0 },
        "last_message_id": { "type": ["string", "null"] },
        "sentinel_hash": { "type": ["string", "null"] }
      }
    },
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strong", "weak"],
      "properties": {
        "strong": { "type": ["string", "null"] },
        "weak": { "type": "string", "minLength": 1 }
      }
    },
    "external_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["board", "id"],
      "properties": {
        "board": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "started": {
      "type": "object",
      "additionalProperties": false,
      "required": ["t", "protocol", "run_id", "sidecar_version", "sources"],
      "properties": {
        "t": { "const": "started" },
        "protocol": { "const": 1 },
        "run_id": { "type": "string", "minLength": 1 },
        "sidecar_version": { "type": "string", "minLength": 1 },
        "sources": { "type": "integer", "minimum": 0 }
      }
    },
    "source_started": {
      "type": "object",
      "additionalProperties": false,
      "required": ["t", "source", "estimated_messages"],
      "properties": {
        "t": { "const": "source_started" },
        "source": { "type": "string", "minLength": 1 },
        "estimated_messages": { "type": "integer", "minimum": 0 }
      }
    },
    "listing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "t",
        "source",
        "message_id",
        "message_date",
        "seq",
        "title",
        "company",
        "location",
        "url",
        "snippet",
        "fingerprint",
        "extractor",
        "extractor_confidence"
      ],
      "properties": {
        "t": { "const": "listing" },
        "source": { "type": "string", "minLength": 1 },
        "message_id": { "type": "string" },
        "message_date": { "type": "string" },
        "seq": { "type": "integer", "minimum": 0 },
        "title": { "type": "string" },
        "company": { "type": "string" },
        "location": { "type": "string" },
        "url": { "type": "string" },
        "external_ref": { "$ref": "#/$defs/external_ref" },
        "snippet": { "type": "string" },
        "posted_at": { "type": ["string", "null"] },
        "fingerprint": { "$ref": "#/$defs/fingerprint" },
        "extractor": { "type": "string", "minLength": 1 },
        "extractor_confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "source_finished": {
      "type": "object",
      "additionalProperties": false,
      "required": ["t", "source", "messages_read", "listings", "skipped", "cursor"],
      "properties": {
        "t": { "const": "source_finished" },
        "source": { "type": "string", "minLength": 1 },
        "messages_read": { "type": "integer", "minimum": 0 },
        "listings": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "cursor": { "$ref": "#/$defs/cursor" }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["t", "code", "detail"],
      "properties": {
        "t": { "const": "warning" },
        "code": { "type": "string", "minLength": 1 },
        "source": { "type": "string" },
        "message_id": { "type": "string" },
        "detail": { "type": "string" }
      }
    },
    "finished": {
      "type": "object",
      "additionalProperties": false,
      "required": ["t", "listings_total", "messages_total", "duration_ms"],
      "properties": {
        "t": { "const": "finished" },
        "listings_total": { "type": "integer", "minimum": 0 },
        "messages_total": { "type": "integer", "minimum": 0 },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "cancelled": { "type": "boolean" }
      }
    }
  }
}
